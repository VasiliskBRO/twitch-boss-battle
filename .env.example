# Обычно этот файл не нужен: «Установить.bat» (node setup.js) сам создаёт .env.
# Ручная настройка — только если у вас СВОЁ приложение в консоли разработчика Твича.
# Файл .env никому не показывайте и не выкладывайте.

# Имя канала, где идёт игра (как в адресе twitch.tv/имя), без @
TWITCH_CHANNEL=

# Логин аккаунта бота, без @
BOT_USER_NAME=

# Только для своего приложения (иначе используется приложение автора игры):
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=      # нужен лишь для Confidential-приложения и входа через node auth.js
