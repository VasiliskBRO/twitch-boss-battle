# Скопируйте этот файл в .env и заполните. Файл .env никому не показывайте и не выкладывайте.

# Из консоли разработчика Твича (dev.twitch.tv/console → ваше приложение)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Имя канала, где идёт игра (как в адресе twitch.tv/имя), без @
TWITCH_CHANNEL=

# Логин аккаунта бота, без @
BOT_USER_NAME=
